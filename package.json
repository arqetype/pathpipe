{
  "name": "pathpipe",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run docker:dev && (trap 'npm run docker:down' EXIT; turbo run dev)",
    "test": "turbo run test",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "docker:dev": "docker compose -f infrastructure/docker/development/docker-compose.yml --env-file .env.development.local up -d",
    "docker:down": "docker compose -f infrastructure/docker/development/docker-compose.yml --env-file .env.development.local down"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.14",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
