{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env.example",
    ".env.development.local",
    ".env.production.local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "NODE_TLS_REJECT_UNAUTHORIZED",
    "NEST_PORT",
    "NEST_DATABASE_HOST",
    "NEST_DATABASE_PORT",
    "NEST_DATABASE_USER",
    "NEST_DATABASE_PASS",
    "NEST_DATABASE_NAME",
    "NEXT_API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "CORS_ORIGIN",
    "NEST_JWT_SECRET",
    "NEST_JWT_EXPIRATION_TIME",
    "NEST_FRONT_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "APP_URL",
    "WORKERS_FRONTEND_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "with": ["worker#dev:email", "worker#dev:ats"]
    },
    "worker#dev:email": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/db#build", "@repo/email#build", "@repo/queues#build"]
    },
    "worker#dev:ats": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/db#build", "@repo/email#build", "@repo/queues#build"]
    },
    "api#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/db#build", "@repo/email#build"]
    },
    "start": {
      "persistent": false,
      "cache": false
    }
  }
}
