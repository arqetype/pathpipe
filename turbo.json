{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "NODE_TLS_REJECT_UNAUTHORIZED",
    "NEST_PORT",
    "NEST_DATABASE_HOST",
    "NEST_DATABASE_PORT",
    "NEST_DATABASE_USER",
    "NEST_DATABASE_PASS",
    "NEST_DATABASE_NAME",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEST_EMAIL_HOST",
    "NEST_EMAIL_PORT",
    "NEST_EMAIL_USER",
    "NEST_EMAIL_PASS",
    "NEST_JWT_SECRET",
    "NEST_JWT_EXPIRATION_TIME",
    "NEST_FRONT_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "workers#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/db#build", "@repo/email#build"]
    },
    "api#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/db#build", "@repo/email#build"]
    },
    "start": {
      "persistent": false,
      "cache": false
    }
  }
}
