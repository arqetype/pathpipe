NODE_ENV=development
GITHUB_OWNER=arqetype
# Production only: domain configured in Dokploy UI
DOMAIN=pathpipe.example.com
# Production only: image tag to pull (defaults to latest)
IMAGE_TAG=latest

NEST_PORT=4000
NEST_DATABASE_USER=postgres
NEST_DATABASE_PASS=postgres
NEST_DATABASE_NAME=pathpipe
NEST_DATABASE_HOST=localhost
NEST_DATABASE_PORT=5432

NEST_JWT_SECRET=change_me_with_openssl_rand_base64_32
NEST_JWT_EXPIRATION_TIME=7d
NEST_FRONT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

NEST_GOOGLE_CLIENT_ID=your_google_client_id
NEST_GOOGLE_CLIENT_SECRET=your_google_client_secret
NEST_GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

NEST_LINKEDIN_CLIENT_ID=your_linkedin_client_id
NEST_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
NEST_LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/linkedin/callback

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Dev: set to http://localhost:4000/ once globalPrefix('api') is active
# Production: NEXT_API_URL used for internal container calls, NEXT_PUBLIC_API_URL for client/OAuth
NEXT_API_URL=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production: https://api-pathpipe.clementomnes.dev
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

WORKERS_PORT=4100
WORKERS_EMAIL_HOST=0.0.0.0
WORKERS_EMAIL_PORT=1025
WORKERS_EMAIL_USER=dev@pathpipe.com
WORKERS_EMAIL_PASS=specialdevpassword
WORKERS_API_URL=http://localhost:4000/
WORKERS_API_KEY=pk_change_me
WORKERS_REDIS_HOST=redis
WORKERS_REDIS_PORT=6379
WORKERS_REDIS_PASSWORD=redis
WORKERS_FRONTEND_URL=http://localhost:3000
